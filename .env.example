# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dhoni_agent
POSTGRES_USER=dhoni_agent
POSTGRES_PASSWORD=replace_with_a_local_secret

# Future integrations — placeholders only. Never commit real values.
GEMINI_API_KEY=replace_me
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
INSTAGRAM_ACCESS_TOKEN=replace_me
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace_me
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value

# External media storage — placeholders only.
GCS_BUCKET=replace_with_your_gcs_bucket
GCP_SERVICE_ACCOUNT_EMAIL=replace_with_your_runtime_service_account
